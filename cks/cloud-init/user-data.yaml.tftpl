#cloud-config
# Prepara il nodo per kubeadm (runtime, kernel, pacchetti).
# Con auto_bootstrap=true crea anche il cluster (kubeadm init/join + Cilium);
# con auto_bootstrap=false init/join li fai tu a mano (è materia d'esame).

users:
  - name: ${lab_user}
    groups: sudo
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_public_key}

# Password solo per la console seriale; via SSH si entra solo con la chiave
chpasswd:
  expire: false
  users:
    - name: ${lab_user}
      password: ${lab_password}
      type: text
ssh_pwauth: false

package_update: true
packages:
  - apt-transport-https
  - ca-certificates
  - curl
  - gpg
  - containerd
  - jq
  - vim
  - bash-completion

write_files:
  # Moduli kernel richiesti: overlay (filesystem dei container), br_netfilter (iptables vede il traffico dei bridge)
  - path: /etc/modules-load.d/k8s.conf
    content: |
      overlay
      br_netfilter

  # Routing tra pod e regole iptables sui bridge
  - path: /etc/sysctl.d/k8s.conf
    content: |
      net.bridge.bridge-nf-call-iptables  = 1
      net.bridge.bridge-nf-call-ip6tables = 1
      net.ipv4.ip_forward                 = 1

  # crictl parla con containerd
  - path: /etc/crictl.yaml
    content: |
      runtime-endpoint: unix:///run/containerd/containerd.sock
      image-endpoint: unix:///run/containerd/containerd.sock

  # kubelet usa l'IP della rete del lab
  - path: /etc/default/kubelet
    content: |
      KUBELET_EXTRA_ARGS=--node-ip=${node_ip}

  # Comodità da esame: alias k + autocompletamento
  - path: /etc/profile.d/k8s.sh
    content: |
      source <(kubectl completion bash)
      alias k=kubectl
      complete -o default -F __start_kubectl k

  # Tutti i nodi si conoscono per nome
  - path: /etc/hosts
    append: true
    content: |
%{ for name, n in nodes ~}
      ${n.ip} ${name}.${domain} ${name}
%{ endfor ~}

runcmd:
  # Kernel
  - modprobe overlay
  - modprobe br_netfilter
  - sysctl --system
  - swapoff -a

  # containerd con cgroup driver systemd (lo stesso di kubelet)
  - mkdir -p /etc/containerd
  - containerd config default > /etc/containerd/config.toml
  - sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
  - systemctl restart containerd
  - systemctl enable containerd

  # Repo ufficiale Kubernetes (pkgs.k8s.io) + kubelet/kubeadm/kubectl bloccati in versione
  - mkdir -p /etc/apt/keyrings
  - curl -fsSL https://pkgs.k8s.io/core:/stable:/${k8s_minor}/deb/Release.key | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
  - echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/${k8s_minor}/deb/ /" > /etc/apt/sources.list.d/kubernetes.list
  - apt-get update
  - apt-get install -y kubelet kubeadm kubectl
  - apt-mark hold kubelet kubeadm kubectl
  - systemctl enable kubelet
%{ if role == "controlplane" ~}

  # Solo control plane: CLI di Cilium (la installerai sul cluster dopo kubeadm init)
  - |
    CILIUM_CLI_VERSION=$(curl -s https://raw.githubusercontent.com/cilium/cilium-cli/main/stable.txt)
    curl -fsSL "https://github.com/cilium/cilium-cli/releases/download/$${CILIUM_CLI_VERSION}/cilium-linux-amd64.tar.gz" | tar xz -C /usr/local/bin
%{ endif ~}
%{ if auto_bootstrap ~}
%{ if role == "controlplane" ~}

  # --- Bootstrap automatico: control plane ---
  - kubeadm init --apiserver-advertise-address=${node_ip} --pod-network-cidr=${pod_cidr} --token=${kubeadm_token} --token-ttl=0
  - mkdir -p /home/${lab_user}/.kube
  - cp /etc/kubernetes/admin.conf /home/${lab_user}/.kube/config
  - chown -R ${lab_user}:${lab_user} /home/${lab_user}/.kube
  - HOME=/root KUBECONFIG=/etc/kubernetes/admin.conf cilium install --set ipam.mode=kubernetes
%{ else ~}

  # --- Bootstrap automatico: worker (riprova finché il control plane non risponde) ---
  - until kubeadm join ${cp_ip}:6443 --token ${kubeadm_token} --discovery-token-unsafe-skip-ca-verification; do kubeadm reset -f; sleep 20; done
%{ endif ~}
%{ endif ~}

  # Segnale che il nodo è pronto
  - touch /var/lib/cloud/k8s-node-ready
